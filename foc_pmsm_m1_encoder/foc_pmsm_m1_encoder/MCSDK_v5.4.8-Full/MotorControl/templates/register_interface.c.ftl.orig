<#function GetSpeedSensor motor aux=false> 
      <#local SENSORS =
        [ {"name": "PLL", "variable": "&STO_PLL"} 
        , {"name": "CORDIC", "variable": "&STO_CR"} 
        , {"name": "HALL", "variable": "&HALL"}
        , {"name": "ENCODER", "variable": "&ENCODER"}
        ] >
      <#if motor == "M1" > 
